{
  "name": "@nanoexpress/addons",
  "version": "1.0.0",
  "description": "Add-on packages for nanoexpress",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.12.1"
  },
  "scripts": {
    "lint": "smartlint",
    "build": "rollup -c",
    "semantic-release": "lerna exec --concurrency 1 -- semantic-release -e semantic-release-monorepo",
    "prepare": "husky",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {},
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.0",
    "eslint-config-airlight-node": "^5.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lint-staged-config-airlight": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-config-airlight": "^6.0.5",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "smartlint": "^7.0.7",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2"
  }
}
